{
    "name": "lapong/lumen-api",
    "description": "Lumen API for JWT Authentication",
    "require": {
        "laravel/lumen-framework": "^10.0",
        "tymon/jwt-auth": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
